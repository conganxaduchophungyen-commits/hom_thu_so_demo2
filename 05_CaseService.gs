function getCaseDetail(payload){try{var s=requireSession_(payload.token),c=findRowById_(SHEETS.CASES,'caseId',safeText_(payload.caseId,50),CASE_FIELDS);if(!c)return fail_('NOT_FOUND','Không tìm thấy hồ sơ.');if(!canViewCase_(s,c))throw new Error('FORBIDDEN');audit_(s.userId,'VIEW_CASE','CASE',c.caseId,s.token,{});var history=getProcessHistory({token:s.token,caseId:c.caseId}).data||[];var attachments=getRows_(SHEETS.ATTACHMENTS,ATTACHMENT_FIELDS).filter(function(a){return a.caseId===c.caseId;}).map(function(a){return {attachmentId:a.attachmentId,fileName:a.fileName,mimeType:a.mimeType,size:a.size,uploadedAt:a.uploadedAt};});if(s.role===ROLES.VIEWER||s.role===ROLES.PROCESSOR){c.reporterPhone='';c.reporterEmail='';if(c.anonymous)c.reporterName='';}return ok_({case:c,categoryLabel:getCategoryLabel_(c.category),priorityLabel:getPriorityLabel_(c.priority),statusLabel:c.status,history:history,attachments:attachments,daysLeft:daysUntil_(c.deadline)},'');}catch(e){return errorResponse_(e);}}
function searchCases(payload){try{var s=requireSession_(payload.token);if(!hasPermission_(s.role,'CASE_VIEW_ALL')&&!hasPermission_(s.role,'CASE_VIEW_ASSIGNED'))throw new Error('FORBIDDEN');var filters=payload.filters||{}, rows=getRows_(SHEETS.CASES,CASE_FIELDS);rows=rows.filter(function(c){if(hasPermission_(s.role,'CASE_VIEW_ASSIGNED')&&!hasPermission_(s.role,'CASE_VIEW_ALL')&&c.assignedTo!==s.userId)return false;if(filters.q){var q=String(filters.q).toLowerCase();if([c.caseId,c.description,c.incidentLocation,c.village,c.reporterPhone].join(' ').toLowerCase().indexOf(q)<0)return false;}if(filters.status&&c.status!==filters.status)return false;if(filters.category&&c.category!==filters.category)return false;if(filters.priority&&c.priority!==filters.priority)return false;if(filters.village&&c.village!==filters.village)return false;if(filters.assignedTo&&c.assignedTo!==filters.assignedTo)return false;if(filters.from&&new Date(c.createdAt)<new Date(filters.from))return false;if(filters.to&&new Date(c.createdAt)>new Date(filters.to+'T23:59:59'))return false;return true;});rows.sort(function(a,b){return new Date(b.createdAt)-new Date(a.createdAt);});var page=Math.max(1,Number(payload.page||1)),size=Math.min(50,Math.max(5,Number(payload.pageSize||20))),total=rows.length,start=(page-1)*size;return ok_({items:rows.slice(start,start+size).map(function(c){return {caseId:c.caseId,createdAt:formatDate_(c.createdAt),category:getCategoryLabel_(c.category),priority:getPriorityLabel_(c.priority),status:c.status,village:c.village,assignedTo:c.assignedTo,deadline:c.deadline,daysLeft:daysUntil_(c.deadline)};}),page:page,pageSize:size,total:total,pages:Math.ceil(total/size)},'');}catch(e){return errorResponse_(e);}}
function canViewCase_(s,c){if(hasPermission_(s.role,'CASE_VIEW_ALL'))return true;return hasPermission_(s.role,'CASE_VIEW_ASSIGNED')&&c.assignedTo===s.userId;}
function addCaseNote(payload){try{var s=requirePermission_(payload.token,'CASE_NOTE'),c=findRowById_(SHEETS.CASES,'caseId',payload.caseId,CASE_FIELDS);if(!c)throw new Error('NOT_FOUND');if(!canViewCase_(s,c))throw new Error('FORBIDDEN');var note=safeText_(payload.note,5000);if(!note)throw new Error('INVALID_INPUT');appendHistory_(c.caseId,'NOTE',c.status,c.status,s.userId,'Ghi chú nghiệp vụ',note);audit_(s.userId,'ADD_NOTE','CASE',c.caseId,s.token,{});return ok_(null,'Đã thêm ghi chú.');}catch(e){return errorResponse_(e);}}
function closeCase(payload){return updateCaseStatus({token:payload.token,caseId:payload.caseId,toStatus:STATUSES.CLOSED,reason:payload.reason,note:payload.note});}
function deleteCase(payload){try{var s=requirePermission_(payload.token,'CASE_DELETE');var c=findRowById_(SHEETS.CASES,'caseId',payload.caseId,CASE_FIELDS);if(!c)throw new Error('NOT_FOUND');var sh=sheet_(SHEETS.CASES), data=sh.getDataRange().getValues(), idx=CASE_FIELDS.indexOf('caseId');for(var i=data.length-1;i>=1;i--)if(String(data[i][idx])===String(c.caseId))sh.deleteRow(i+1);audit_(s.userId,'DELETE_CASE','CASE',c.caseId,s.token,{});return ok_(null,'Đã xóa hồ sơ.');}catch(e){return errorResponse_(e);}}
function getProcessHistory(payload){try{var s=requireSession_(payload.token),c=findRowById_(SHEETS.CASES,'caseId',payload.caseId,CASE_FIELDS);if(!c||!canViewCase_(s,c))throw new Error('FORBIDDEN');return ok_(getRows_(SHEETS.PROCESS_HISTORY,HISTORY_FIELDS).filter(function(h){return h.caseId===c.caseId;}).sort(function(a,b){return new Date(a.performedAt)-new Date(b.performedAt);}), '');}catch(e){return errorResponse_(e);}}
function appendHistory_(caseId,action,from,to,by,reason,note){appendRow_(SHEETS.PROCESS_HISTORY,HISTORY_FIELDS,{historyId:uuid_('HIS'),caseId:caseId,action:action,fromStatus:from,toStatus:to,performedBy:by,performedAt:now_(),reason:reason||'',note:note||''});}
