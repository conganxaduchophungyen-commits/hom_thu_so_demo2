function runAllTests(){var results=[];function test(name,fn){try{fn();results.push({name:name,pass:true});}catch(e){results.push({name:name,pass:false,error:String(e.message||e)});}}test('CONFIG',function(){if(!APP_CONFIG.APP_NAME)throw new Error('APP_NAME');});test('STATE_MACHINE',function(){if(STATE_TRANSITIONS.NEW.indexOf('RECEIVED')<0)throw new Error('transition');});test('VILLAGES',function(){if(VILLAGES.length!==11)throw new Error('villages');});test('CASE_ID',function(){if(!/^DH-\\d{4}-\\d{6}$/.test(generateCaseId_()))throw new Error('case id');});test('TRACKING',function(){if(!generateTrackingCode_())throw new Error('tracking');});test('PASSWORD_HASH',function(){var r=createPasswordRecord_('abc');if(hashPassword_('abc',r.salt)!==r.hash)throw new Error('hash');});test('PERMISSION',function(){if(!hasPermission_(ROLES.SUPER_ADMIN,'ANY'))throw new Error('admin permission');if(hasPermission_(ROLES.VIEWER,'USERS_MANAGE'))throw new Error('viewer permission');});test('LEGAL_RULE',function(){if(getLegalRule_('ANTT','NORMAL')===null)throw new Error('rule');});return ok_({passed:results.filter(function(r){return r.pass;}).length,total:results.length,results:results},'Hoàn tất test suite.');}
