function updateCaseStatus(payload){try{var s=requirePermission_(payload.token,'CASE_STATUS'),c=findRowById_(SHEETS.CASES,'caseId',payload.caseId,CASE_FIELDS);if(!c)throw new Error('NOT_FOUND');if(!canViewCase_(s,c)&&!hasPermission_(s.role,'CASE_VIEW_ALL'))throw new Error('FORBIDDEN');var from=c.status,to=safeText_(payload.toStatus,40);if(!STATE_TRANSITIONS[from]||STATE_TRANSITIONS[from].indexOf(to)<0)throw new Error('INVALID_TRANSITION');if(to===STATUSES.CLOSED&&!hasPermission_(s.role,'CASE_ASSIGN')&&!hasPermission_(s.role,'*'))throw new Error('FORBIDDEN');var patch={status:to,updatedAt:now_()};if(to===STATUSES.CLOSED)patch.closedAt=now_();updateRowById_(SHEETS.CASES,'caseId',c.caseId,CASE_FIELDS,patch);appendHistory_(c.caseId,'CHANGE_STATUS',from,to,s.userId,safeText_(payload.reason,1000),safeText_(payload.note,5000));audit_(s.userId,'CHANGE_STATUS','CASE',c.caseId,s.token,{fromStatus:from,toStatus:to});if(c.reporterEmail&&c.contactConsent)notifyCitizenStatus_(c,to);return ok_({status:to,statusLabel:PUBLIC_STATUS_LABELS[to]||to},'Cập nhật trạng thái thành công.');}catch(e){return errorResponse_(e);}}
