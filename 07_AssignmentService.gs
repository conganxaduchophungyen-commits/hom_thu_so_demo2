function assignCase(payload){try{var s=requirePermission_(payload.token,'CASE_ASSIGN'),c=findRowById_(SHEETS.CASES,'caseId',payload.caseId,CASE_FIELDS);if(!c)throw new Error('NOT_FOUND');var user=findRowById_(SHEETS.USERS,'userId',payload.userId,USER_FIELDS);if(!user||user.status!=='ACTIVE')throw new Error('INVALID_INPUT');var from=c.status,to=(from===STATUSES.CLASSIFIED||from===STATUSES.TRANSFERRED)?STATUSES.ASSIGNED:from;var patch={assignedTo:user.userId,assignedAt:now_(),updatedAt:now_()};if(to!==from)patch.status=to;updateRowById_(SHEETS.CASES,'caseId',c.caseId,CASE_FIELDS,patch);appendHistory_(c.caseId,'ASSIGN',from,to,s.userId,'Phân công cán bộ',user.fullName);audit_(s.userId,'ASSIGN','CASE',c.caseId,s.token,{assignee:user.userId});notifyAssignment_(c,user);return ok_(null,'Đã phân công hồ sơ.');}catch(e){return errorResponse_(e);}}
function transferCase(payload){try{var s=requirePermission_(payload.token,'CASE_TRANSFER'),c=findRowById_(SHEETS.CASES,'caseId',payload.caseId,CASE_FIELDS);if(!c)throw new Error('NOT_FOUND');var user=findRowById_(SHEETS.USERS,'userId',payload.userId,USER_FIELDS);if(!user)throw new Error('INVALID_INPUT');var from=c.status;updateRowById_(SHEETS.CASES,'caseId',c.caseId,CASE_FIELDS,{assignedTo:user.userId,assignedAt:now_(),status:STATUSES.TRANSFERRED,updatedAt:now_()});appendHistory_(c.caseId,'TRANSFER',from,STATUSES.TRANSFERRED,s.userId,safeText_(payload.reason,1000),user.fullName);audit_(s.userId,'TRANSFER','CASE',c.caseId,s.token,{to:user.userId});notifyAssignment_(c,user);return ok_(null,'Đã điều chuyển hồ sơ.');}catch(e){return errorResponse_(e);}}
