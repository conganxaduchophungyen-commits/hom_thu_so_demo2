function setupDemoData(){ensureInitialized_();var existing=getRows_(SHEETS.CASES,CASE_FIELDS);if(existing.length)return ok_(null,'Đã có dữ liệu, bỏ qua demo.');var users=getRows_(SHEETS.USERS,USER_FIELDS);var processors=users.filter(function(u){return u.role===ROLES.PROCESSOR;});if(!processors.length){for(var i=1;i<=5;i++){var rec=createPasswordRecord_('1');appendRow_(SHEETS.USERS,USER_FIELDS,{userId:uuid_('USR'),email:'demo'+i+'@example.local',fullName:'Cán bộ Demo '+i,loginName:'demo'+i,role:i===1?ROLES.LEAD:ROLES.PROCESSOR,department:APP_CONFIG.ORG_NAME,villages:VILLAGES.slice((i-1)*2,(i-1)*2+2).join(','),status:'ACTIVE',mustChangePassword:true,createdAt:now_(),lastLoginAt:'',passwordRecord:JSON.stringify(rec)});}processors=getRows_(SHEETS.USERS,USER_FIELDS).filter(function(u){return u.role===ROLES.PROCESSOR;});}for(var j=0;j<10;j++){var id=generateCaseId_(), p=PRIORITIES[j%3].value, c={caseId:id,publicTrackingCode:generateTrackingCode_(),createdAt:new Date(Date.now()-j*86400000),updatedAt:now_(),category:CATEGORIES[j%CATEGORIES.length].value,priority:p,status:[STATUSES.NEW,STATUSES.CLASSIFIED,STATUSES.ASSIGNED,STATUSES.PROCESSING,STATUSES.VERIFYING,STATUSES.RESOLVED][j%6],incidentDate:'',incidentLocation:'Địa bàn thôn '+VILLAGES[j%VILLAGES.length],village:VILLAGES[j%VILLAGES.length],description:'Dữ liệu demo - không phải thông tin thật.',relatedPersons:'',latitude:'',longitude:'',anonymous:true,reporterName:'',reporterPhone:'',reporterEmail:'',contactConsent:false,assignedTo:processors.length?processors[j%processors.length].userId:'',assignedAt:now_(),deadline:new Date(Date.now()+(j===9?-2:5)*86400000),closedAt:'',resolution:'',source:'DEMO',attachmentFolderId:''};appendRow_(SHEETS.CASES,CASE_FIELDS,c);}return ok_(null,'Đã tạo 10 hồ sơ demo.');}
