function safeText_(value,max){var s=String(value===undefined||value===null?'':value);s=s.replace(/[<>]/g,'').replace(/\u0000/g,'').trim();return s.substring(0,max||5000);}
function validateCaseInput_(p){if(!p||!p.category||!p.description)throw new Error('INVALID_INPUT');if(!CATEGORIES.some(function(c){return c.value===p.category;}))throw new Error('INVALID_CATEGORY');if(PRIORITIES.map(function(x){return x.value;}).indexOf(p.priority)<0)throw new Error('INVALID_PRIORITY');if(p.description.length<10||p.description.length>10000)throw new Error('INVALID_DESCRIPTION');if(p.village&&VILLAGES.indexOf(p.village)<0)throw new Error('INVALID_VILLAGE');if(p.anonymous!==true&&p.anonymous!==false)throw new Error('INVALID_REPORTER_MODE');if(!p.anonymous&&!p.contactConsent)throw new Error('CONTACT_CONSENT_REQUIRED');}
function sanitizePublicCase_(p){return {category:safeText_(p.category,40),priority:safeText_(p.priority,20),incidentDate:safeText_(p.incidentDate,40),incidentLocation:safeText_(p.incidentLocation,500),village:safeText_(p.village,100),description:safeText_(p.description,10000),relatedPersons:safeText_(p.relatedPersons,3000),latitude:safeText_(p.latitude,30),longitude:safeText_(p.longitude,30),anonymous:!!p.anonymous,reporterName:p.anonymous?'':safeText_(p.reporterName,150),reporterPhone:p.anonymous?'':safeText_(p.reporterPhone,40),reporterEmail:p.anonymous?'':safeText_(p.reporterEmail,150),contactConsent:!!p.contactConsent,attachments:p.attachments||[]};}
function validateAttachments_(attachments){if(!attachments)return [];if(!Array.isArray(attachments)||attachments.length>APP_CONFIG.MAX_FILES)throw new Error('TOO_MANY_FILES');return attachments.map(function(f){var name=safeText_(f.name,180),mime=safeText_(f.mimeType,100),size=Number(f.size||0);var allowed=['image/jpeg','image/png','image/webp','video/mp4','application/pdf','text/plain','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-excel','application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];if(allowed.indexOf(mime)<0)throw new Error('FILE_TYPE_NOT_ALLOWED');if(size<=0||size>APP_CONFIG.MAX_FILE_BYTES)throw new Error('FILE_SIZE_NOT_ALLOWED');if(/[\\/<>:"|?*\x00-\x1F]/.test(name))throw new Error('FILE_NAME_INVALID');return {name:name,mimeType:mime,size:size,data:String(f.data||'')};});}
