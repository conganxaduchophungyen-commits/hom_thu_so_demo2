function listUsers(payload){try{requirePermission_(payload.token,'USERS_MANAGE');return ok_(getRows_(SHEETS.USERS,USER_FIELDS).map(function(u){delete u.passwordRecord;return u;}),'');}catch(e){return errorResponse_(e);}}
function saveUser(payload){try{var s=requirePermission_(payload.token,'USERS_MANAGE'),p=payload.user||{};var fullName=safeText_(p.fullName,150),loginName=safeText_(p.loginName,60),email=safeText_(p.email,150),role=safeText_(p.role,30);if(!fullName||!loginName||!role)throw new Error('INVALID_INPUT');if(!ROLE_PERMISSIONS[role])throw new Error('INVALID_INPUT');var existing=p.userId?findRowById_(SHEETS.USERS,'userId',p.userId,USER_FIELDS):null;var users=getRows_(SHEETS.USERS,USER_FIELDS);if(users.some(function(u){return u.loginName.toLowerCase()===loginName.toLowerCase()&&(!existing||u.userId!==existing.userId);}))throw new Error('INVALID_INPUT');var data={userId:existing?existing.userId:uuid_('USR'),email:email,fullName:fullName,loginName:loginName,role:role,department:safeText_(p.department,150),villages:Array.isArray(p.villages)?p.villages.filter(function(v){return VILLAGES.indexOf(v)>=0;}).join(','):safeText_(p.villages,500),status:p.status==='INACTIVE'?'INACTIVE':'ACTIVE',mustChangePassword:existing?existing.mustChangePassword:true,createdAt:existing?existing.createdAt:now_(),lastLoginAt:existing?existing.lastLoginAt:'',passwordRecord:existing?existing.passwordRecord:JSON.stringify(createPasswordRecord_('1'))};if(existing&&p.password){data.passwordRecord=JSON.stringify(createPasswordRecord_(String(p.password)));data.mustChangePassword=true;}if(existing)updateRowById_(SHEETS.USERS,'userId',existing.userId,USER_FIELDS,data);else appendRow_(SHEETS.USERS,USER_FIELDS,data);audit_(s.userId,'SAVE_USER','USER',data.userId,s.token,{role:role});return ok_({userId:data.userId},'Đã lưu tài khoản. Mật khẩu mặc định khi tạo mới là 1; yêu cầu đổi ở lần đăng nhập đầu.');}catch(e){return errorResponse_(e);}}
function deleteUser(payload){try{var s=requirePermission_(payload.token,'USERS_MANAGE');if(payload.userId===s.userId)throw new Error('CANNOT_DELETE');var u=findRowById_(SHEETS.USERS,'userId',payload.userId,USER_FIELDS);if(!u)throw new Error('NOT_FOUND');updateRowById_(SHEETS.USERS,'userId',u.userId,USER_FIELDS,{status:'INACTIVE'});audit_(s.userId,'DELETE_USER','USER',u.userId,s.token,{});return ok_(null,'Đã vô hiệu hóa tài khoản.');}catch(e){return errorResponse_(e);}}
function resetUserPassword(payload){try{var s=requirePermission_(payload.token,'USERS_MANAGE');var u=findRowById_(SHEETS.USERS,'userId',payload.userId,USER_FIELDS);if(!u)throw new Error('NOT_FOUND');updateRowById_(SHEETS.USERS,'userId',u.userId,USER_FIELDS,{passwordRecord:JSON.stringify(createPasswordRecord_('1')),mustChangePassword:true});audit_(s.userId,'RESET_PASSWORD','USER',u.userId,s.token,{});return ok_(null,'Đã reset mật khẩu về 1.');}catch(e){return errorResponse_(e);}}
