function runDeadlineCheck(){try{ensureInitialized_();var rows=getRows_(SHEETS.CASES,CASE_FIELDS);var active=[STATUSES.CLOSED,STATUSES.RESOLVED,STATUSES.CANCELLED];var warned=0;rows.forEach(function(c){if(!c.deadline||active.indexOf(c.status)>=0)return;var d=daysUntil_(c.deadline);if(d<0){notifyDeadline_(c,'ĐÃ QUÁ HẠN');warned++;}else if(d<=1){notifyDeadline_(c,'SẮP ĐẾN HẠN');warned++;}else if((c.priority==='URGENT'||c.priority==='CRITICAL')&&c.status===STATUSES.NEW){notifyDeadline_(c,'HỒ SƠ KHẨN CHƯA ĐƯỢC XỬ LÝ');warned++;}});sendQueuedNotifications();return ok_({checked:rows.length,warned:warned},'Đã kiểm tra deadline.');}catch(e){return errorResponse_(e);}}
