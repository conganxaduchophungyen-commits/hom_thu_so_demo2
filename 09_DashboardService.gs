function getDashboard(payload){try{var s=requireSession_(payload.token);if(!hasPermission_(s.role,'DASHBOARD'))throw new Error('FORBIDDEN');var filters=payload.filters||{},rows=getRows_(SHEETS.CASES,CASE_FIELDS);rows=rows.filter(function(c){if(filters.from&&new Date(c.createdAt)<new Date(filters.from))return false;if(filters.to&&new Date(c.createdAt)>new Date(filters.to+'T23:59:59'))return false;if(filters.category&&c.category!==filters.category)return false;if(filters.status&&c.status!==filters.status)return false;if(filters.village&&c.village!==filters.village)return false;if(filters.priority&&c.priority!==filters.priority)return false;return true;});var today=Utilities.formatDate(now_(),APP_CONFIG.TIMEZONE,'yyyy-MM-dd');var weekStart=new Date(Date.now()-6*86400000);var monthStart=new Date(new Date().getFullYear(),new Date().getMonth(),1);var count=function(fn){return rows.filter(fn).length;};var stats={total:rows.length,today:count(function(c){return String(c.createdAt).indexOf(today)===0;}),week:count(function(c){return new Date(c.createdAt)>=weekStart;}),month:count(function(c){return new Date(c.createdAt)>=monthStart;}),processing:count(function(c){return [STATUSES.PROCESSING,STATUSES.VERIFYING,STATUSES.WAITING_INFO].indexOf(c.status)>=0;}),resolved:count(function(c){return [STATUSES.RESOLVED,STATUSES.CLOSED].indexOf(c.status)>=0;}),overdue:count(function(c){return c.deadline&&new Date(c.deadline)<new Date()&&[STATUSES.CLOSED,STATUSES.RESOLVED,STATUSES.CANCELLED].indexOf(c.status)<0;}),urgent:count(function(c){return c.priority==='URGENT'||c.priority==='CRITICAL';}),unassigned:count(function(c){return !c.assignedTo&&c.status!=='CLOSED';})};var group=function(key){var o={};rows.forEach(function(c){var v=c[key]||'Chưa xác định';o[v]=(o[v]||0)+1;});return o;};return ok_({stats:stats,byCategory:group('category'),byStatus:group('status'),byVillage:group('village'),byPriority:group('priority'),byAssignee:group('assignedTo')},'');}catch(e){return errorResponse_(e);}}
