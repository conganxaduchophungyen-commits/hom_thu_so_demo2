function queueNotification_(caseId,recipient,type,message){appendRow_(SHEETS.NOTIFICATIONS,NOTIFICATION_FIELDS,{notificationId:uuid_('NOT'),caseId:caseId,recipient:recipient,type:type,message:safeText_(message,1000),createdAt:now_(),sentAt:'',status:'QUEUED'});}
function sendQueuedNotifications(){var rows=getRows_(SHEETS.NOTIFICATIONS,NOTIFICATION_FIELDS,500), sh=sheet_(SHEETS.NOTIFICATIONS), data=sh.getDataRange().getValues();rows.filter(function(n){return n.status==='QUEUED';}).slice(0,30).forEach(function(n){try{if(!n.recipient)return;MailApp.sendEmail({to:n.recipient,subject:'Hòm thư tố giác tội phạm số - Thông báo',body:n.message});updateRowById_(SHEETS.NOTIFICATIONS,'notificationId',n.notificationId,NOTIFICATION_FIELDS,{sentAt:now_(),status:'SENT'});}catch(e){updateRowById_(SHEETS.NOTIFICATIONS,'notificationId',n.notificationId,NOTIFICATION_FIELDS,{status:'ERROR'});logError_('sendNotification',e);}});}
function notifyNewCase_(c){queueNotification_(c.caseId,APP_CONFIG.ALERT_EMAIL,'NEW_CASE','Có tin báo mới: '+c.caseId+'. Vui lòng đăng nhập hệ thống để xem và xử lý.');sendQueuedNotifications();}
function notifyAssignment_(c,user){if(user.email)queueNotification_(c.caseId,user.email,'ASSIGNMENT','Hồ sơ '+c.caseId+' đã được phân công cho đồng chí. Vui lòng đăng nhập hệ thống để xem chi tiết.');sendQueuedNotifications();}
function notifyCitizenStatus_(c,status){if(c.reporterEmail)queueNotification_(c.caseId,c.reporterEmail,'STATUS','Hồ sơ '+c.caseId+' đã cập nhật trạng thái: '+(PUBLIC_STATUS_LABELS[status]||status)+'. Không gửi thông tin nghiệp vụ nhạy cảm qua email.');sendQueuedNotifications();}
function notifyDeadline_(c,level){var recipients=[APP_CONFIG.ALERT_EMAIL];var users=getRows_(SHEETS.USERS,USER_FIELDS).filter(function(u){return u.status==='ACTIVE'&&(u.role===ROLES.LEAD||u.role===ROLES.ADMIN||u.role===ROLES.SUPER_ADMIN);});users.forEach(function(u){if(u.email)recipients.push(u.email);});recipients.filter(function(x,i,a){return x&&a.indexOf(x)===i;}).forEach(function(r){queueNotification_(c.caseId,r,'DEADLINE', 'Cảnh báo deadline hồ sơ '+c.caseId+': '+level+'. Vui lòng đăng nhập hệ thống.');});}
